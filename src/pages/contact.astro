---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import RedactieBlokken from '../components/RedactieBlokken.astro';
import { paginas, sectie } from '../data/redactie';
const page=paginas['/contact/'];
import { site } from '../data/site';
---
<Base title="Contact" description={page.seo}>
  <header class="page-head">
    <div class="wrap">
      <p class="eyebrow">Contact</p>
      <h1>Bespreek een vraagstuk</h1>
      <RedactieBlokken blocks={page.hero} />
    </div>
  </header>
  <section class="tight">
    <div class="wrap two-col">
      <div class="card">
        <h2 style="font-size:1.25rem">Mail of bel</h2>
        <p><a class="textlink" id="mail" href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a></p>
        <RedactieBlokken blocks={sectie(page,'Mail of bel')!.blocks.slice(1)} />
      </div>
      <div class="card">
        <h2 style="font-size:1.25rem">Handig om te vertellen</h2>
        <RedactieBlokken blocks={sectie(page,'Handig')!.blocks} />
      </div>
    </div>
  </section>
  <section class="tight"><div class="wrap"><h2>Wat er daarna gebeurt</h2><RedactieBlokken blocks={sectie(page,'Wat er daarna')!.blocks} kaarten /></div></section>
  <!-- TODO: formulier toevoegen (bijv. Vercel/Formspree) zodra de keuze is gemaakt. -->
  <script>
    // Neem het onderwerp van een aanbodpagina mee in de mail.
    const onderwerp = new URLSearchParams(location.search).get('onderwerp');
    const a = document.getElementById('mail') as HTMLAnchorElement | null;
    if (onderwerp && a) a.href += `?subject=${encodeURIComponent('Vraagstuk: ' + onderwerp)}`;
  </script>
</Base>
