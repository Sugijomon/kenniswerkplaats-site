---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MensIllustratie from '../components/MensIllustratie.astro';
import { vraagstukken } from '../data/vraagstukken';
import { aanbodBySlug } from '../data/aanbod';
---
<Base title="Vraagstukken" description="Herken je jouw vraagstuk? Van ongecontroleerd AI-gebruik tot samenwerken aan een gedeeld platform.">
  <header class="page-head">
    <div class="wrap">
      <div class="question-hero"><div><p class="eyebrow">Vraagstukken</p>
      <h1>Herken je dit?</h1>
      <p class="lead">Ik begin bij het vraagstuk, niet bij een product. Kies wat het meest op jouw situatie lijkt; je ziet dan hoe ik het zou aanpakken.</p>
      </div><MensIllustratie /></div>
    </div>
  </header>
  <section class="tight" aria-labelledby="vraagstukken-lijst">
    <h2 id="vraagstukken-lijst" class="sr-only">Alle vraagstukken</h2>
    <div class="wrap grid grid-3">
      {vraagstukken.map((v) => (
        <a class="card vraag-tile" href={`/aanbod/${v.aanbod}/`} id={v.id}>
          <span class="ico"><Icon name={v.icoon} size={28} /></span>
          <h3>{v.titel}</h3>
          <p>{v.tekst}</p>
          <span class="go">{aanbodBySlug[v.aanbod].naam} <Icon name="arrow" size={14} /></span>
        </a>
      ))}
    </div>
  </section>
  <section class="tight">
    <div class="wrap">
      <div class="cta-bar">
        <p>Staat jouw vraagstuk er niet tussen?</p>
        <a class="btn" href="/contact/">Bespreek een vraagstuk <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</Base>
<style>.question-hero { display:grid; grid-template-columns:1.5fr 1fr; gap:40px; align-items:center; }@media(max-width:760px) { .question-hero { grid-template-columns:1fr; gap:24px; }.question-hero :global(img) { max-width:360px; margin:auto; } }</style>
