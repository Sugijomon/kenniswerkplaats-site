---
import Base from '../layouts/Base.astro';
import RedactieBlokken from '../components/RedactieBlokken.astro';
import { paginas } from '../data/redactie';
const page=paginas['/over/'];
---
<Base title="Over" description={page.seo}><header class="page-head"><div class="wrap"><p class="eyebrow">Over</p><h1>{page.title}</h1><RedactieBlokken blocks={page.hero.slice(0,1)} /></div></header><section class="tight"><div class="wrap"><RedactieBlokken blocks={page.hero.slice(1)} /></div></section>{page.sections.map(s=><section class="tight"><div class="wrap"><h2>{s.title}</h2><RedactieBlokken blocks={s.blocks} kaarten={s.title==='Waar ik sterk in ben'} /></div></section>)}</Base>
<style>h2 { font-size:1.7rem; margin-bottom:24px; }</style>
