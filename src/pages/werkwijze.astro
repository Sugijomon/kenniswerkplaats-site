---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import KunstAccent from '../components/KunstAccent.astro';
import { fasen } from '../data/fasen';
import { aanbod } from '../data/aanbod';

import RedactieBlokken from '../components/RedactieBlokken.astro';
import { paginas, sectie } from '../data/redactie';
const page=paginas['/werkwijze/'];
---
<Base title="Werkwijze" description={page.seo}>
  <header class="page-head">
    <KunstAccent beeld="samenhang" />
    <div class="wrap">
      <p class="eyebrow">Werkwijze</p>
      <h1>Van vraagstuk naar werkende praktijk</h1>
      <RedactieBlokken blocks={page.hero} />
    </div>
  </header>

  <section class="tight">
    <div class="wrap grid grid-2">
      {fasen.map((f) => {
        const items = aanbod.filter((a) => a.fasen.includes(f.key));
        return (
          <div class="card" id={f.key}>
            <p class="eyebrow">Fase {f.nr}</p>
            <h2 style="font-size:1.4rem">{f.naam}</h2>
            <p style="font-weight:600;color:var(--teal-900)">{f.vraag}</p>
            <p style="color:var(--ink-2)">{f.tekst}</p>
            <div class="fase-tags">
              {items.map((a) => <a class="fase-tag" href={`/aanbod/${a.slug}/`} style="text-decoration:none">{a.naam}</a>)}
            </div>
            <p style="margin:14px 0 0"><a class="textlink" href={`/cases/#${f.key}`}>Cases in deze fase <Icon name="arrow" size={14} /></a></p>
          </div>
        );
      })}
    </div>
    <div class="wrap">
      <p class="loop-note"><Icon name="loop" size={20} /> Fase 4 voedt fase 1: wat je evalueert, is vaak de verkenning van de volgende ronde.</p>
    </div>
  </section>

  {['Het recept','Wat in elke fase'].map(t=><section><div class="wrap"><h2>{sectie(page,t)!.title}</h2><RedactieBlokken blocks={sectie(page,t)!.blocks} kaarten={t==='Wat in elke fase'} /></div></section>)}

  <section class="tight">
    <div class="wrap">
      <div class="cta-bar">
        <p>Waar sta jij in je vraagstuk?</p>
        <a class="btn" href="/contact/">Plan een kennismaking <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
</Base>
<style>.page-head { position:relative; overflow:hidden; }.page-head .wrap { position:relative; z-index:1; }</style>
