---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';
const variants = [
  { id:'fade', name:'A. Zachte overgang onderaan', description:'De kunst vloeit vanuit de onderrand omhoog. Logo, links en contact staan op een rustig vlak.' },
  { id:'artcard', name:'B. Kunstkaart rechts', description:'Een afzonderlijk kunstvlak naast de informatie. De afbeelding blijft zichtbaar zonder achter de tekst te komen.' },
  { id:'dark', name:'C. Donkere footer met watermerk', description:'Donker petrol met lichte tekst. De kunst verschijnt subtiel op de achtergrond.' },
];
const links = [ ['Vraagstukken','/vraagstukken/'],['Werkwijze','/werkwijze/'],['Aanbod','/aanbod/'],['Werkplaats','/werkplaats/'],['Over','/over/'],['Contact','/contact/'] ];
---
<Base title="Footervarianten vergelijken">
  <header class="page-head"><div class="wrap"><p class="eyebrow">Ontwerpvoorbeelden</p><h1>Drie manieren om de pagina af te sluiten</h1><p class="lead">Dezelfde kunst en informatie, telkens anders toegepast. De links werken; op mobiel past elke variant zich aan.</p><nav class="variant-jump" aria-label="Footervarianten">{variants.map(v => <a href={`#${v.id}`}>{v.name}</a>)}</nav></div></header>
  <div class="wrap examples">
    {variants.map(v => <section id={v.id} class="example"><h2>{v.name}</h2><p>{v.description}</p>
      <footer class={`demo-footer ${v.id}`} aria-label={`Voorbeeldfooter ${v.name}`}>
        <div class="demo-content">
          <div class="identity">{v.id === 'dark' ? <a class="dark-logo" href="/" aria-label="Kenniswerkplaats naar homepage"><img src="/favicon2.png" width="50" height="50" alt=""/><span>Kenniswerkplaats<small>Mensen · Kennis · Technologie</small></span></a> : <Logo />}<p>{site.tagline}</p></div>
          <nav class="demo-nav" aria-label={`Navigatie ${v.name}`}>{links.map(([label,href]) => <a href={href}>{label}</a>)}</nav>
          <div class="contact"><a href={`mailto:${site.email}`}>{site.email}</a><p>{site.plaats}</p></div>
        </div>
        {v.id === 'artcard' && <div class="art-frame"><img src="/footer-kunst.png" width="2172" height="724" alt="" loading="lazy"/></div>}
        {v.id === 'fade' && <div class="fade-art" aria-hidden="true"><img src="/footer-kunst.png" width="2172" height="724" alt="" loading="lazy"/></div>}
      </footer>
    </section>)}
  </div>
</Base>
<style>
  .variant-jump { display:flex; flex-wrap:wrap; gap:12px; margin-top:24px; }.variant-jump a { display:block; padding:10px 16px; border:1px solid var(--line); border-radius:24px; background:white; text-decoration:none; }
  .examples { padding-bottom:40px; }.example { padding:36px 0; scroll-margin-top:90px; }.example>p { color:var(--ink-2); }
  .demo-footer { position:relative; overflow:hidden; border:1px solid var(--line); border-radius:24px; background:#f2f7f9; margin-top:24px; }
  .demo-content { display:grid; grid-template-columns:1.25fr 1fr 1fr; gap:28px; padding:36px; position:relative; z-index:1; }.identity p { margin:16px 0 0; max-width:300px; color:var(--ink-2); font-size:.9375rem; }.demo-nav { display:flex; flex-wrap:wrap; gap:12px 20px; align-content:start; }.demo-nav a { font-size:.9375rem; text-decoration:none; font-weight:550; }.demo-nav a:hover { text-decoration:underline; }.contact { font-size:.9375rem; }.contact p { margin:8px 0 0; color:var(--ink-2); }
  .fade { padding-bottom:140px; }.fade-art { position:absolute; bottom:0; left:0; right:0; height:180px; pointer-events:none; mask-image:linear-gradient(to top,black 0%,black 20%,transparent 100%); }.fade-art img { width:100%; height:100%; object-fit:cover; object-position:center 60%; }
  .artcard { display:grid; grid-template-columns:1.6fr 1fr; align-items:center; background:white; padding:36px; gap:28px; }.artcard .demo-content { padding:0; grid-template-columns:1fr; gap:24px; }.art-frame { border:1px solid var(--line); border-radius:20px; overflow:hidden; height:240px; box-shadow:var(--shadow); }.art-frame img { width:100%; height:100%; object-fit:cover; object-position:center; }
  .dark { background:#034f64; color:white; isolation:isolate; min-height:280px; }.dark::before { content:''; position:absolute; inset:0; z-index:0; background:url('/footer-kunst.png') center/cover; opacity:.13; mix-blend-mode:luminosity; mask-image:linear-gradient(90deg,transparent 10%,black); pointer-events:none; }.dark .demo-content { padding:48px 36px; }.dark a { color:white; }.dark .identity p,.dark .contact p { color:#d9eaf1; }.dark-logo { display:flex; align-items:center; gap:10px; font-size:1.3rem; font-weight:750; text-decoration:none; }.dark-logo img { flex-shrink:0; }.dark-logo small { display:block; font-size:.7rem; font-weight:500; color:#d9eaf1; margin-top:4px; }.dark :focus-visible { outline-color:#f5b42c; }
  @media(max-width:900px) { .demo-content { grid-template-columns:1fr 1fr; }.contact { grid-column:1/-1; }.artcard { grid-template-columns:1.2fr 1fr; } }
  @media(max-width:600px) { .demo-content { grid-template-columns:1fr; padding:24px; }.contact { grid-column:auto; }.artcard { grid-template-columns:1fr; padding:24px; }.art-frame { height:180px; }.dark .demo-content { padding:28px 24px; }.fade { padding-bottom:110px; }.fade-art { height:130px; } }
</style>
