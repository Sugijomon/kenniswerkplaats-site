---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import FaseStrip from '../../components/FaseStrip.astro';
import CaseVisualisatie from '../../components/CaseVisualisatie.astro';
import { varianten } from '../../data/caseVisualisaties';
import { aanbod, groepen, aanbodBySlug, type AanbodItem } from '../../data/aanbod';
import { caseById } from '../../data/cases';
import { fasen } from '../../data/fasen';

const a = aanbodBySlug['ontwerp-en-ontwikkeling'];
const groep = groepen.find((g) => g.naam === a.groep)!;
const verwant = groep.items.filter((s) => s !== a.slug).map((s) => aanbodBySlug[s]);
const cases = a.cases.map((id) => caseById[id]).filter(Boolean);
---
<Base title={`${a.naam} — voorbeeld casevisualisaties`} description={a.kort}>
  <header class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/aanbod/">Aanbod</a> / {a.groep}</p>
      <p class="eyebrow">{a.groep}</p>
      <h1>{a.naam} {a.instap && <span class="badge">Instap</span>}</h1>
      <p class="lead">{a.intro}</p>
      <div class="hero-actions">
        <a class="btn" href={`/contact/?onderwerp=${encodeURIComponent(a.naam)}`}>Bespreek je vraagstuk <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </header>

  <section class="tight">
    <div class="wrap">
      <p class="eyebrow">Waar dit in een traject zit</p>
      <FaseStrip active={a.fasen} compact />
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="note" style="margin-bottom:24px"><strong>Herkenbaar?</strong> {a.vraag}</div>
      <div class="two-col">
        <div class="card">
          <h2 style="font-size:1.25rem">Wat je krijgt</h2>
          <ul class="check-list">{a.jeKrijgt.map((x) => <li>{x}</li>)}</ul>
        </div>
        <div class="card">
          <h2 style="font-size:1.25rem">Hoe ik werk</h2>
          <ul class="check-list">{a.zoWerkIk.map((x) => <li>{x}</li>)}</ul>
        </div>
      </div>
      {a.noot && <p class="note" style="margin-top:20px">{a.noot}</p>}
    </div>
  </section>

  {cases.length > 0 && (
    <section class="cases-section">
      <div class="wrap">
        <p class="eyebrow">Praktijkcases</p>
        <h2>Vier manieren om cases te tonen</h2>
        <p class="prose" style="color:var(--ink-2)">{a.casesIntro}</p>
        <div class="legend" aria-hidden="true">
          <span class="dot v2"><span class="pip"></span>fase bewezen</span>
          <span class="dot v1"><span class="pip"></span>deels</span>
          <span class="dot v0"><span class="pip"></span>niet in deze case</span>
        </div>
        <nav aria-label="Vergelijk de varianten" class="variant-nav">{varianten.map((v, i) => <a href={`#${v.id}`}>{i + 1}. {v.naam}</a>)}</nav>{varianten.map((v, i) => <section id={v.id} class="variant-section"><h2>{i + 1}. {v.naam}</h2><p>{v.tekst}</p><div class="cases-grid">
          {cases.map((c) => <CaseVisualisatie c={c} variant={v.id} />)}
        </div></section>)} 
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <h2 style="font-size:1.35rem">Meer binnen {a.groep}</h2>
      <div class="grid grid-2">
        {verwant.map((v) => (
          <a class="card aanbod-card" href={`/aanbod/${v.slug}/`}>
            <h3>{v.naam}</h3>
            <p>{v.kort}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>.variant-nav{display:flex;flex-wrap:wrap;gap:12px;margin:24px 0}.variant-nav a{padding:10px 16px;border:1px solid var(--line);border-radius:24px;background:white}.variant-section{padding:36px 0;scroll-margin-top:100px}.variant-section>p{margin-bottom:24px}.cases-grid{grid-template-columns:repeat(2,minmax(0,1fr))}@media(max-width:760px){.cases-grid{grid-template-columns:1fr}}</style>