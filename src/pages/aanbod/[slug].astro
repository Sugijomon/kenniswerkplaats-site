---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import FaseStrip from '../../components/FaseStrip.astro';
import CaseCard from '../../components/CaseCard.astro';
import RedactieBlokken from '../../components/RedactieBlokken.astro';
import FinancieringBlok from '../../components/FinancieringBlok.astro';
import { paginas } from '../../data/redactie';
import { aanbod, groepen, aanbodBySlug, type AanbodItem } from '../../data/aanbod';
import { caseById } from '../../data/cases';
export function getStaticPaths() { return aanbod.filter(a => !['ai-foto','grip-op-ai-in-hr','ai-op-orde'].includes(a.slug)).map(a => ({ params: { slug:a.slug }, props:{a} })); }
const { a } = Astro.props as { a: AanbodItem };
const page = paginas[`/aanbod/${a.slug}/`];
const groep = groepen.find(g => g.naam === a.groep)!;
const verwant = groep.items.filter(s => s !== a.slug).map(s => aanbodBySlug[s]);
const governance=a.slug==='governance-en-evaluatie', ontwerp=a.slug==='ontwerp-en-ontwikkeling';
const visueel=governance||ontwerp;
---
<Base title={a.naam} description={page.seo}>
  <div class:list={[`domein-${a.domein}`, { 'governance-page':visueel, 'ontwerp-page':ontwerp, 'art-background':visueel }]} style={ontwerp?'--background-art:url(/ontwerp-achtergrondkunst.png)':governance?'--background-art:url(/kunst/richting.png)':undefined}>
    <header class="page-head"><div class="wrap"><p class="crumbs"><a href="/aanbod/">Aanbod</a> / {a.groep}</p><div class:list={{ 'governance-hero':visueel }}><div><p class="eyebrow">{a.groep}</p><h1>{a.naam} {a.instap && <span class="badge">Instap</span>}</h1><p class="service-subtitle">{page.subtitle}</p><p class="lead">{a.intro}</p><div class="hero-actions"><a class="btn" href={`/contact/?onderwerp=${encodeURIComponent(a.naam)}`}>Bespreek je vraagstuk <Icon name="arrow" size={18} /></a></div></div>{visueel && <div class="art-space" aria-hidden="true"></div>}</div></div></header>
    <section class="tight"><div class="wrap"><p class="eyebrow">Waar dit in een traject zit</p><FaseStrip active={a.fasen} compact />{a.slug==='praktijklab' && <p class="vorm-noot">Als werkvorm inzetbaar in elke fase.</p>}<div class="note" style="margin-top:24px"><strong>Herkenbaar?</strong> {a.vraag}</div></div></section>
    {page.sections.filter(s => !s.title.startsWith('Meer binnen')).map(s => s.title==='Zo kun je het financieren' ? <FinancieringBlok slug={a.slug} /> : s.caseIds.length ? <section class="cases-section"><div class="wrap"><h2>{s.title}</h2><RedactieBlokken blocks={s.blocks} /><div class="cases-grid">{s.caseIds.map(id => <CaseCard c={caseById[id]} highlight={a.fasen} />)}</div></div></section> : <section class="content-section"><div class="wrap"><h2>{s.title}</h2><RedactieBlokken blocks={s.blocks} kaarten={['Wat je krijgt','Hoe ik werk','Vier vaste vragen','Zo bestel je een module','Voor wie'].includes(s.title)} /></div></section>)}
    {!page.sections.some(s => s.title==='Zo kun je het financieren') && <FinancieringBlok slug={a.slug} />}
    <section><div class="wrap"><h2>Meer binnen {a.groep}</h2><div class="grid grid-2">{verwant.map(v => <a class="card aanbod-card" href={`/aanbod/${v.slug}/`}><h3>{v.naam}</h3><p>{v.kort}</p></a>)}</div></div></section>
  </div>
</Base>
<style>.service-subtitle { font-size:1.4rem; font-weight:650; line-height:1.4; color:var(--ink); }.vorm-noot { color:var(--ink-3); font-size:.9375rem; }.content-section:nth-of-type(odd) { background:var(--paper); }.content-section h2 { font-size:1.7rem; margin-bottom:26px; }</style>
<style>
  .governance-hero { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(260px,1fr); gap:40px; align-items:center; }
  .governance-page .lead { max-width:44rem; }
  .governance-page .note { display:flex; align-items:center; gap:18px; background:var(--domein-tint); border-color:var(--domein-color); color:var(--ink-2); padding:20px 24px; border-radius:0 14px 14px 0; }
  .governance-page .note :global(svg) { flex-shrink:0; }
  .icon-list li { padding:0; display:flex; align-items:flex-start; gap:14px; margin-bottom:16px; }
  .icon-list li::before { display:none; }
  .icon-list :global(svg) { flex-shrink:0; margin-top:3px; color:var(--domein-icon); }

  .ontwerp-page :global(.cases-section) { background:var(--surface); }
  /* Selectieve beeldfragmenten; de contentlaag blijft rustig en klikbaar. */
  .art-background .page-head { position:relative; isolation:isolate; overflow:hidden; }
  .art-background .page-head::before { filter:grayscale(1); content:''; position:absolute; z-index:-1; pointer-events:none; right:-70px; top:-100px; width:min(650px,58vw); height:650px; background:var(--background-art) center/cover no-repeat; opacity:.16; mask-image:linear-gradient(90deg,transparent,black 38%),linear-gradient(180deg,black 60%,transparent); mask-composite:intersect; }
  .art-space { min-height:310px; }
  .art-background .crumbs { width:fit-content; background:var(--paper); }
  .art-background>section { position:relative; isolation:isolate; }
  .art-background>section:nth-of-type(2)::before { filter:grayscale(1); content:''; position:absolute; z-index:-1; pointer-events:none; left:0; top:0; width:180px; height:100%; background:var(--background-art) 20% 60%/500px auto no-repeat; opacity:.07; mask-image:linear-gradient(90deg,black,transparent); }
  .art-background :global(.cases-section) { overflow:hidden; }
  .art-background :global(.cases-section)::before { filter:grayscale(1); content:''; position:absolute; z-index:-1; pointer-events:none; right:-80px; bottom:-180px; width:460px; height:460px; background:var(--background-art) center/cover no-repeat; opacity:.09; mask-image:radial-gradient(ellipse,black 20%,transparent 70%); }
  .art-background>section:last-child::before { filter:grayscale(1); content:''; position:absolute; z-index:-1; pointer-events:none; left:0; bottom:0; width:230px; height:180px; background:var(--background-art) bottom left/420px auto no-repeat; opacity:.06; mask-image:linear-gradient(90deg,black,transparent); }
  @media(max-width:760px) { .art-space { display:none; }.art-background .page-head::before { right:-180px; top:0; width:440px; height:440px; opacity:.07; }.art-background>section:nth-of-type(2)::before,.art-background>section:last-child::before { filter:grayscale(1); display:none; } }
  @media(max-width:760px) { .governance-hero { grid-template-columns:1fr; gap:24px; } .governance-hero :global(.governance-art),.governance-hero :global(.platform-art) { max-width:300px; } }
</style>

