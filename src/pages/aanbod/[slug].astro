---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import FaseStrip from '../../components/FaseStrip.astro';
import CaseCard from '../../components/CaseCard.astro';
import GovernanceIllustratie from '../../components/GovernanceIllustratie.astro';
import PlatformIllustratie from '../../components/PlatformIllustratie.astro';
import { aanbod, groepen, aanbodBySlug, type AanbodItem } from '../../data/aanbod';
import { caseById } from '../../data/cases';
import { fasen } from '../../data/fasen';

export function getStaticPaths() {
  return aanbod.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: AanbodItem };
const groep = groepen.find((g) => g.naam === a.groep)!;
const verwant = groep.items.filter((s) => s !== a.slug).map((s) => aanbodBySlug[s]);
const cases = a.cases.map((id) => caseById[id]).filter(Boolean);
const governance = a.slug === 'governance-en-evaluatie';
const ontwerp = a.slug === 'ontwerp-en-ontwikkeling';
const visueel = governance || ontwerp;
---
<Base title={a.naam} description={a.kort}>
  <div class:list={{ 'governance-page': visueel, 'ontwerp-page': ontwerp }}>
  <header class="page-head">
    <div class="wrap">
      <p class="crumbs"><a href="/aanbod/">Aanbod</a> / {a.groep}</p>
      <div class:list={{ 'governance-hero': visueel }}><div>
      <p class="eyebrow">{a.groep}</p>
      <h1>{a.naam} {a.instap && <span class="badge">Instap</span>}</h1>
      <p class="lead">{a.intro}</p>
      <div class="hero-actions">
        <a class="btn" href={`/contact/?onderwerp=${encodeURIComponent(a.naam)}`}>Bespreek je vraagstuk <Icon name="arrow" size={18} /></a>
      </div>
      </div>{governance && <GovernanceIllustratie />}{ontwerp && <PlatformIllustratie />}</div>
    </div>
  </header>

  <section class="tight">
    <div class="wrap">
      <p class="eyebrow">Waar dit in een traject zit</p>
      <FaseStrip active={a.fasen} compact />
    </div>
  </section>

  <section class="tight">
    <div class="wrap">
      <div class="note" style="margin-bottom:24px">{visueel && <Icon name="search" size={28} />}<span><strong>Herkenbaar?</strong> {a.vraag}</span></div>
      <div class="two-col">
        <div class="card">
          <h2 style="font-size:1.25rem">Wat je krijgt</h2>
          <ul class:list={['check-list', { 'icon-list': visueel }]}>{a.jeKrijgt.map((x, i) => <li>{visueel && <Icon name={['doc', 'layers', 'link'][i] ?? 'doc'} size={24} />}<span>{x}</span></li>)}</ul>
        </div>
        <div class="card">
          <h2 style="font-size:1.25rem">Hoe ik werk</h2>
          <ul class:list={['check-list', { 'icon-list': visueel }]}>{a.zoWerkIk.map((x, i) => <li>{visueel && <Icon name={['layers', 'people', 'chart'][i] ?? 'target'} size={24} />}<span>{x}</span></li>)}</ul>
        </div>
      </div>
      {a.noot && <p class="note" style="margin-top:20px">{a.noot}</p>}
    </div>
  </section>

  {cases.length > 0 && (
    <section class="cases-section">
      <div class="wrap">
        <p class="eyebrow">Praktijkcases</p>
        <h2>Eerder aangepakt</h2>
        <p class="prose" style="color:var(--ink-2)">{a.casesIntro}</p>
        <div class="legend" aria-hidden="true">
          <span class="dot v2"><span class="pip"></span>fase bewezen</span>
          <span class="dot v1"><span class="pip"></span>deels</span>
          <span class="dot v0"><span class="pip"></span>niet in deze case</span>
        </div>
        <div class="cases-grid">
          {cases.map((c) => <CaseCard c={c} highlight={a.fasen} />)}
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap">
      <h2 style="font-size:1.35rem">Meer binnen {a.groep}</h2>
      <div class="grid grid-2">
        {verwant.map((v) => (
          <a class="card aanbod-card" href={`/aanbod/${v.slug}/`}>
            <h3>{v.naam}</h3>
            <p>{v.kort}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  </div>
</Base>
<style>
  .governance-hero { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(260px,1fr); gap:40px; align-items:center; }
  .governance-page .lead { max-width:44rem; }
  .governance-page .note { display:flex; align-items:center; gap:18px; background:#fff0cf; border-color:#dba536; color:#624612; padding:20px 24px; border-radius:0 14px 14px 0; }
  .governance-page .note :global(svg) { flex-shrink:0; }
  .icon-list li { padding:0; display:flex; align-items:flex-start; gap:14px; margin-bottom:16px; }
  .icon-list li::before { display:none; }
  .icon-list :global(svg) { flex-shrink:0; margin-top:3px; color:#117a65; }
  .icon-list li:nth-child(2) :global(svg) { color:#a87512; }
  .icon-list li:nth-child(3) :global(svg) { color:#a81c60; }
  .governance-page :global(.fase-strip li.dim) { opacity:1; background:transparent; border-color:var(--line); color:var(--ink-2); }
  .governance-page :global(.fase-strip li:nth-child(1) .nr) { background:#117a65; }
  .governance-page :global(.fase-strip li:nth-child(2) .nr) { background:#94640e; }
  .governance-page :global(.fase-strip li:nth-child(3) .nr) { background:#c8156b; }
  .governance-page :global(.fase-strip li:nth-child(4) .nr) { background:#183e55; }
  .governance-page :global(.fase-strip li.on) { box-shadow:0 10px 28px #183e5518; border:2px solid #183e55; }
  .ontwerp-page .note { background:#eaf3f8; border-color:var(--brand-blue-dark); color:var(--ink-2); }
  .ontwerp-page .icon-list :global(svg) { color:var(--brand-blue-dark); }
  .ontwerp-page :global(.fase-strip li.dim) { color:var(--ink-3); background:transparent; }
  .ontwerp-page :global(.fase-strip li.on) { border-color:var(--brand-blue-dark); background:#fff; }
  @media(max-width:760px) { .governance-hero { grid-template-columns:1fr; gap:24px; } .governance-hero :global(.governance-art),.governance-hero :global(.platform-art) { max-width:300px; } }
</style>
