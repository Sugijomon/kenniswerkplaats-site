---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import KunstAccent from '../../components/KunstAccent.astro';
import AanbodVoorbeeldDienst from '../../components/AanbodVoorbeeldDienst.astro';
import { aanbodVoorbeelden as v } from '../../data/aanbod-voorbeelden';
import { groepen, aanbodBySlug } from '../../data/aanbod';
import { fasen } from '../../data/fasen';
const [ai, leren, platforms] = groepen;
const kunst = { ai: 'richting', leren: 'samenhang', platforms: 'linten' } as const;
---
<Base title="Aanbodoverzichten vergelijken" description={v.intro}>
  <header class="page-head"><div class="wrap"><p class="eyebrow">Ontwerpvoorbeelden · Aanbod</p><h1>{v.titel}</h1><p class="lead">{v.intro}</p><nav class="voorbeeld-nav" aria-label="Kies een aanbodvoorbeeld">{v.varianten.map((x,i) => <a href={`#${x.id}`}><span>{i+1}</span>{x.naam}<Icon name="arrow" size={16} /></a>)}</nav><p class="voorbeeld-noot">{v.noot} <a href="/aanbod/">Bekijk het huidige aanbod</a></p></div></header>

  <section id="tabs" class="voorbeeld-sectie"><div class="wrap"><div class="voorbeeld-kop"><p class="eyebrow">Voorbeeld 1</p><h2>{v.varianten[0].naam}</h2><p>{v.varianten[0].tekst}</p></div>
    <div class="tabbed" data-aanbod-tabs>
      <nav class="categorie-tabs" aria-label="Aanbodcategorieën">{groepen.map((g,i) => <a href={`#canvas-${g.key}`} id={`tab-${g.key}`} data-categorie-tab={g.key}><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span>{g.naam}</a>)}</nav>
      {groepen.map(g => <div class="canvas" id={`canvas-${g.key}`} data-categorie-panel={g.key}>
        <div class="canvas-context"><h3>{g.naam}</h3><p>{g.tekst}</p><div class="canvas-kunst"><KunstAccent beeld={kunst[g.key]} vorm="beeld" /></div></div>
        <div class="canvas-diensten">{g.items.map(slug => <AanbodVoorbeeldDienst item={aanbodBySlug[slug]} />)}</div>
      </div>)}
    </div>
  </div></section>

  <section id="blokken" class="voorbeeld-sectie zacht"><div class="wrap"><div class="voorbeeld-kop"><p class="eyebrow">Voorbeeld 2</p><h2>{v.varianten[1].naam}</h2><p>{v.varianten[1].tekst}</p></div>
    <div class="editorial">
      <div class="ai-blok"><div class="blok-heading"><span class="pijler-nr" aria-hidden="true">01</span><div><h3>{ai.naam}</h3><p>{ai.tekst}</p></div></div><div class="ai-diensten">{ai.items.map(slug => <AanbodVoorbeeldDienst item={aanbodBySlug[slug]} />)}</div></div>
      <div class="leren-blok"><div class="leren-feature"><span class="pijler-nr" aria-hidden="true">02</span><h3>{leren.naam}</h3><p>{leren.tekst}</p><AanbodVoorbeeldDienst item={aanbodBySlug[leren.items[0]]} /></div><div class="leren-stapel">{leren.items.slice(1).map(slug => <AanbodVoorbeeldDienst item={aanbodBySlug[slug]} />)}</div></div>
      <div class="platform-blok"><div class="blok-heading"><span class="pijler-nr" aria-hidden="true">03</span><div><h3>{platforms.naam}</h3><p>{platforms.tekst}</p></div></div><div class="platform-proces">{platforms.items.map((slug,i) => <div class="proces-stap"><AanbodVoorbeeldDienst item={aanbodBySlug[slug]} nummer={i+1} />{i<2 && <span class="proces-pijl" aria-hidden="true">→</span>}</div>)}</div><p class="traject-noot">{v.trajectNoot}</p></div>
    </div>
  </div></section>

  <section id="matrix" class="voorbeeld-sectie"><div class="wrap"><div class="voorbeeld-kop"><p class="eyebrow">Voorbeeld 3</p><h2>{v.varianten[2].naam}</h2><p>{v.varianten[2].tekst}</p></div>
    <div data-aanbod-matrix>
      <form class="matrix-filters" hidden><label>Categorie<select name="categorie"><option value="alle">Alle categorieën</option>{groepen.map(g => <option value={g.key}>{g.naam}</option>)}</select></label><label>Trajectfase<select name="fase"><option value="alle">Alle fasen</option>{fasen.map(f => <option value={f.key}>{f.nr}. {f.naam}</option>)}</select></label><button type="reset">Wis filters <Icon name="loop" size={18} /></button><p class="matrix-status" role="status" aria-live="polite">9 diensten</p></form>
      <div class="matrix-overzicht">
        <div class="matrix-head" aria-hidden="true"><span>Categorie / fase</span>{fasen.map(f => <div data-fase-kolom={f.key}><span>{f.nr}</span>{f.naam}</div>)}</div>
        {groepen.map(g => <section class="matrix-rij" data-matrix-groep={g.key} aria-labelledby={`matrix-${g.key}`}><div class="matrix-categorie"><h3 id={`matrix-${g.key}`}>{g.naam}</h3></div>{fasen.map(f => <div class="matrix-cel" data-fase-kolom={f.key}><h4>{f.nr}. {f.naam}</h4>{g.items.filter(slug => aanbodBySlug[slug].fasen.includes(f.key)).map(slug => <a class="matrix-dienst" data-matrix-dienst={slug} href={`/aanbod/${slug}/`}><strong>{aanbodBySlug[slug].naam}</strong><span>{aanbodBySlug[slug].kort}</span><Icon name="arrow" size={16} /></a>)}{!g.items.some(slug => aanbodBySlug[slug].fasen.includes(f.key)) && <p class="lege-cel">Geen aanbodonderdeel in deze fase.</p>}</div>)}</section>)}
      </div>
      <p class="matrix-leeg" hidden>Geen diensten bij deze combinatie. Kies een andere categorie of fase.</p><p class="traject-noot">{v.trajectNoot} Een dienst met meerdere fasen verschijnt op meerdere plekken.</p>
    </div>
  </div></section>
  <section class="tight"><div class="wrap"><div class="voorbeeld-afsluiting"><p>Kies de indeling die voor jou het duidelijkst voelt: 1, 2 of 3.</p><a class="textlink" href="/aanbod/">Terug naar het huidige aanbod <Icon name="arrow" size={18} /></a></div></div></section>
</Base>
<script>
  document.querySelectorAll<HTMLElement>('[data-aanbod-tabs]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLAnchorElement>('[data-categorie-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-categorie-panel]')];
    root.querySelector('.categorie-tabs')?.setAttribute('role','tablist');
    const activate = (tab: HTMLAnchorElement) => {
      tabs.forEach(t => { const selected = t === tab; t.setAttribute('aria-selected',String(selected)); t.tabIndex = selected ? 0 : -1; });
      panels.forEach(panel => { panel.hidden = panel.dataset.categoriePanel !== tab.dataset.categorieTab; });
    };
    tabs.forEach((tab,i) => {
      tab.setAttribute('role','tab'); tab.setAttribute('aria-controls',`canvas-${tab.dataset.categorieTab}`);
      panels[i].setAttribute('role','tabpanel'); panels[i].setAttribute('aria-labelledby',tab.id); panels[i].tabIndex = 0;
      tab.addEventListener('click',event => { event.preventDefault(); activate(tab); });
      tab.addEventListener('keydown',event => {
        const positions: Record<string,number> = { ArrowRight:(i+1)%tabs.length, ArrowDown:(i+1)%tabs.length, ArrowLeft:(i+tabs.length-1)%tabs.length, ArrowUp:(i+tabs.length-1)%tabs.length, Home:0, End:tabs.length-1 };
        if (!(event.key in positions)) return;
        event.preventDefault(); const next=tabs[positions[event.key]]; activate(next); next.focus();
      });
    });
    const requested=tabs.find(t=>t.hash===location.hash);
    activate(requested ?? tabs[0]);
  });
  document.querySelectorAll<HTMLElement>('[data-aanbod-matrix]').forEach(root => {
    const form=root.querySelector<HTMLFormElement>('form')!;
    const group=form.querySelector<HTMLSelectElement>('[name="categorie"]')!;
    const phase=form.querySelector<HTMLSelectElement>('[name="fase"]')!;
    const overview=root.querySelector<HTMLElement>('.matrix-overzicht')!;
    const update=()=>{
      const services=new Set<string>();
      root.querySelectorAll<HTMLElement>('[data-fase-kolom]').forEach(col=>{ col.hidden=phase.value!=='alle' && col.dataset.faseKolom!==phase.value; });
      root.querySelectorAll<HTMLElement>('[data-matrix-groep]').forEach(row=>{
        const categoryMatches=group.value==='alle' || row.dataset.matrixGroep===group.value;
        const visibleServices=[...row.querySelectorAll<HTMLElement>('[data-matrix-dienst]')].filter(link=>!link.closest<HTMLElement>('[data-fase-kolom]')!.hidden);
        row.hidden=!categoryMatches || !visibleServices.length;
        if (!row.hidden) visibleServices.forEach(link=>services.add(link.dataset.matrixDienst!));
      });
      overview.style.setProperty('--matrix-columns',phase.value==='alle'?'4':'1');
      root.querySelector<HTMLElement>('.matrix-status')!.textContent=`${services.size} ${services.size===1?'dienst':'diensten'}`;
      root.querySelector<HTMLElement>('.matrix-leeg')!.hidden=services.size!==0;
      overview.hidden=services.size===0;
    };
    form.hidden=false; form.addEventListener('submit',event=>event.preventDefault());
    form.addEventListener('change',update);
    form.addEventListener('reset',()=>{ group.value='alle'; phase.value='alle'; update(); });
    update();
  });
</script>
<style>
  .voorbeeld-nav { display:flex; gap:12px; flex-wrap:wrap; margin-top:28px; }.voorbeeld-nav a { display:flex; align-items:center; gap:10px; padding:12px 16px; background:white; border:1px solid var(--line-2); border-radius:24px; text-decoration:none; font-weight:600; }.voorbeeld-nav a>span { font-size:.875rem; color:var(--ink-3); }.voorbeeld-noot { font-size:.9375rem; color:var(--ink-3); margin-top:24px; }
  .voorbeeld-sectie { scroll-margin-top:88px; padding:56px 0; }.voorbeeld-kop { margin-bottom:32px; }.voorbeeld-kop h2 { font-size:clamp(1.6rem,3vw,2rem); }.voorbeeld-kop>p:last-child { max-width:48rem; color:var(--ink-2); }.zacht { background:var(--surface); }
  .categorie-tabs { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; margin-bottom:20px; }.categorie-tabs a { display:flex; align-items:center; gap:12px; min-height:76px; padding:18px; border:1px solid var(--line-2); border-radius:16px; background:white; font-weight:650; text-decoration:none; }.categorie-tabs a>span { display:grid; place-items:center; width:32px; height:32px; flex-shrink:0; border-radius:50%; background:var(--surface); color:var(--ink-3); font-size:.8125rem; }.categorie-tabs [aria-selected="true"] { border-color:var(--action); background:var(--action-tint); box-shadow:inset 0 0 0 1px var(--action); }.categorie-tabs [aria-selected="true"]>span { background:var(--action); color:white; }
  .canvas { display:grid; grid-template-columns:minmax(0,.85fr) minmax(0,1.2fr); gap:40px; padding:36px; border:1px solid var(--line-2); border-radius:var(--radius); background:white; margin-bottom:20px; }.canvas[hidden] { display:none; }.canvas h3 { font-size:1.65rem; line-height:1.2; }.canvas-context>p { color:var(--ink-2); }.canvas-kunst { margin-top:24px; opacity:.72; }.canvas-kunst :global(.beeld) { height:190px; }.canvas-diensten { display:grid; gap:14px; }
  .editorial { display:grid; gap:36px; }.ai-blok,.platform-blok { background:white; padding:32px; border-radius:var(--radius); border:1px solid var(--line-2); }.ai-blok { background:var(--paper); }.blok-heading { display:flex; gap:20px; align-items:flex-start; margin-bottom:24px; }.blok-heading h3,.leren-feature h3 { font-size:1.5rem; line-height:1.25; }.blok-heading p { color:var(--ink-2); margin:8px 0 0; }.pijler-nr { display:grid; place-items:center; width:44px; height:44px; border-radius:50%; background:var(--action-tint); color:var(--ink); font-weight:700; flex-shrink:0; }.ai-diensten { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; }.ai-diensten :global(.voorbeeld-dienst) { flex-direction:column; }.ai-diensten :global(.dienst-arrow) { margin-top:auto; }
  .leren-blok { display:grid; grid-template-columns:1.1fr 1fr; gap:28px; align-items:center; }.leren-feature { padding:32px; background:var(--paper); border:1px solid var(--line-2); border-radius:var(--radius); }.leren-feature>.pijler-nr { margin-bottom:20px; }.leren-feature>p { color:var(--ink-2); margin:16px 0 24px; }.leren-feature :global(.voorbeeld-dienst) { height:auto; }.leren-stapel { display:grid; gap:20px; }
  .platform-proces { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }.proces-stap { position:relative; min-width:0; }.proces-stap :global(.voorbeeld-dienst) { flex-direction:column; background:var(--paper); }.proces-stap :global(.dienst-icon) { color:var(--ink); background:var(--surface); }.proces-stap :global(.dienst-arrow) { display:none; }.proces-pijl { position:absolute; right:-20px; top:40px; color:var(--ink-3); }.traject-noot { color:var(--ink-3); font-size:.9375rem; margin:24px 0 0; }
  .matrix-filters { display:flex; flex-wrap:wrap; align-items:flex-end; gap:20px; margin:0 0 28px; }.matrix-filters[hidden] { display:none; }.matrix-filters label { display:grid; gap:8px; font-size:.875rem; font-weight:650; flex:1; min-width:220px; }.matrix-filters select { width:100%; font:inherit; color:var(--action); background:white; border:1px solid var(--line-2); padding:12px; border-radius:12px; min-height:48px; }.matrix-filters button { display:flex; align-items:center; gap:10px; font:inherit; color:var(--action); background:white; border:1px solid var(--line-2); border-radius:12px; padding:12px 16px; cursor:pointer; min-height:48px; }.matrix-status { margin:0; min-height:48px; display:flex; align-items:center; color:var(--ink-3); font-size:.875rem; }
  .matrix-overzicht { --matrix-columns:4; border:1px solid var(--line-2); border-radius:var(--radius); overflow:hidden; background:white; }.matrix-head,.matrix-rij { display:grid; grid-template-columns:180px repeat(var(--matrix-columns),minmax(0,1fr)); }.matrix-head { background:var(--surface); }.matrix-head>span,.matrix-head>div { padding:20px 16px; font-size:.875rem; font-weight:650; }.matrix-head>div>span { display:block; color:var(--ink-3); margin-bottom:6px; }.matrix-rij { padding:0; border-top:1px solid var(--line-2); }.matrix-rij[hidden],.matrix-overzicht[hidden] { display:none; }.matrix-categorie { padding:24px 16px; background:var(--paper); }.matrix-categorie h3 { font-size:1rem; line-height:1.4; }.matrix-cel { min-width:0; border-left:1px solid var(--line); padding:16px 10px; display:flex; flex-direction:column; gap:12px; }.matrix-cel[hidden],.matrix-head>[hidden] { display:none; }.matrix-cel>h4 { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .matrix-dienst { display:flex; flex-direction:column; gap:10px; min-width:0; background:var(--action-tint); border:1px solid var(--line-2); border-radius:12px; padding:14px 12px; text-decoration:none; }.matrix-dienst:hover { border-color:var(--action); }.matrix-dienst strong { font-size:.9375rem; line-height:1.35; overflow-wrap:anywhere; }.matrix-dienst>span { color:var(--ink-2); font-size:.8125rem; line-height:1.5; }.matrix-dienst svg { margin-top:2px; }.lege-cel { color:var(--ink-3); font-size:.8125rem; margin:0; }.matrix-leeg { padding:24px; background:var(--surface); border-radius:var(--radius-sm); }.voorbeeld-afsluiting { border-top:1px solid var(--line-2); padding-top:24px; display:flex; justify-content:space-between; gap:24px; flex-wrap:wrap; }.voorbeeld-afsluiting p { margin:0; }
  @media(max-width:1000px) { .canvas { gap:24px; padding:28px; }.ai-diensten,.platform-proces { grid-template-columns:1fr; }.ai-diensten :global(.voorbeeld-dienst),.proces-stap :global(.voorbeeld-dienst) { flex-direction:row; }.proces-pijl { display:none; }.matrix-head,.matrix-rij { grid-template-columns:140px repeat(var(--matrix-columns),minmax(0,1fr)); }.matrix-cel { padding:12px 8px; }.matrix-dienst { padding:12px 10px; } }
  @media(max-width:760px) { .categorie-tabs { grid-template-columns:1fr; gap:8px; }.categorie-tabs a { min-height:58px; padding:12px 16px; }.canvas,.leren-blok { grid-template-columns:1fr; }.canvas-kunst :global(.beeld) { height:130px; max-width:none; }.canvas { padding:24px; }.leren-feature,.ai-blok,.platform-blok { padding:24px; }.matrix-head { display:none; }.matrix-rij { display:block; }.matrix-categorie { padding:20px; }.matrix-cel { display:block; padding:20px; border-left:0; border-top:1px solid var(--line); }.matrix-cel>h4 { position:static; width:auto; height:auto; overflow:visible; clip-path:none; white-space:normal; font-size:.9375rem; margin:0 0 12px; }.matrix-dienst { margin-top:12px; padding:16px; }.matrix-filters label { min-width:0; flex-basis:100%; }.matrix-dienst strong { font-size:1rem; }.matrix-dienst>span { font-size:.9375rem; }.lege-cel { font-size:.875rem; }.voorbeeld-sectie { padding:36px 0; } }
  @media(prefers-reduced-motion:reduce) { * { scroll-behavior:auto; } }
</style>
