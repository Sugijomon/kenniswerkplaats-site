---
import type { TekstBlok } from '../data/redactie';
interface Props { blocks: TekstBlok[]; kaarten?: boolean }
const { blocks, kaarten = false } = Astro.props;
---
<div class="redactie-blokken">
  {blocks.map(b => b.type === 'paragraph' ? <div class="redactie-prose" set:html={b.html} /> : b.type === 'list' ? (
    b.ordered ? <ol class:list={{ 'tekst-kaarten': kaarten }}>{b.itemsHtml?.map(item => <li set:html={item} />)}</ol> : <ul class:list={['check-list', { 'tekst-kaarten': kaarten }]}>{b.itemsHtml?.map(item => <li set:html={item} />)}</ul>
  ) : b.type === 'table' && b.headers?.[0] === '' ? (
    <div class="variant-grid">{b.headers.slice(1).map((header,i) => <article class="variant-card"><h3>{header}</h3><dl>{b.rowsHtml?.map(row => <div><dt set:html={row[0]} /><dd set:html={row[i+1]} /></div>)}</dl></article>)}</div>
  ) : b.type === 'table' ? (
    <div class="tabel-kaarten">{b.rowsHtml?.map(row => <article class="tabel-kaart">{row.map((cell,i) => i === 0 ? <h3 set:html={cell} /> : <div><span class="tabel-label">{b.headers?.[i]}</span><div set:html={cell} /></div>)}</article>)}</div>
  ) : null)}
</div>
<style>
  .redactie-prose { color:var(--ink-2); max-width:52rem; }.redactie-prose :global(p) { margin:0 0 20px; }.redactie-prose :global(a) { color:var(--action); }.redactie-prose :global(strong) { color:var(--ink); }
  .tabel-kaarten + .redactie-prose,.variant-grid + .redactie-prose,.tekst-kaarten + .redactie-prose { margin-top:24px; }
  .tekst-kaarten,.tabel-kaarten,.variant-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:22px; margin:24px 0 0; }.tekst-kaarten { list-style:none; padding:0; counter-reset:stap; }.tekst-kaarten>li { padding:24px; border:1px solid var(--line-2); border-radius:var(--radius); background:white; color:var(--ink-2); }.tekst-kaarten>li::before { display:none; }.tekst-kaarten>li :global(strong) { display:block; margin-bottom:10px; color:var(--ink); font-size:1.12rem; }.tekst-kaarten>li :global(p) { margin:0; }
  .variant-card,.tabel-kaart { min-width:0; border:1px solid var(--line-2); border-radius:var(--radius); background:white; padding:26px; }.variant-card h3,.tabel-kaart h3 { font-size:1.2rem; line-height:1.3; margin-bottom:18px; }.variant-card dl { margin:0; display:grid; gap:18px; }.variant-card dt,.tabel-label { color:var(--ink-3); font-size:.8125rem; font-weight:650; display:block; margin-bottom:5px; }.variant-card dd { margin:0; color:var(--ink-2); font-size:.9375rem; }.tabel-kaart>div { margin:14px 0 0; color:var(--ink-2); }.tabel-kaart :global(p) { margin:0; }
  ol.tekst-kaarten>li { counter-increment:stap; }ol.tekst-kaarten>li::before { content:counter(stap); position:static; display:grid; place-items:center; width:36px; height:36px; margin-bottom:16px; background:var(--surface); color:var(--ink); border-radius:50%; font-weight:700; }
  @media(max-width:900px) { .variant-grid,.tabel-kaarten,.tekst-kaarten { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:600px) { .variant-grid,.tabel-kaarten,.tekst-kaarten { grid-template-columns:1fr; }.variant-card,.tabel-kaart,.tekst-kaarten>li { padding:22px; } }
</style>
