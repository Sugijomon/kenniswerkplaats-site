---
import type { GroepKey } from '../data/aanbod';
interface Props { groep: GroepKey }
const { groep } = Astro.props;
---
<svg viewBox="0 0 400 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {groep === 'ai' ? <>
