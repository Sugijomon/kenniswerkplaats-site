// Tijdelijk woordmerk: vier tegels die samen één vorm maken. Vervang door het definitieve logo.
---
<a href="/" class="logo" aria-label="Kenniswerkplaats, naar de homepage">
  <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
    <g transform="rotate(45 16 16)">
      <rect x="6" y="6" width="9.5" height="9.5" rx="1.5" fill="var(--logo-magenta, var(--teal-700))"/>
      <rect x="16.5" y="6" width="9.5" height="9.5" rx="1.5" fill="var(--logo-green, var(--teal-500))"/>
      <rect x="6" y="16.5" width="9.5" height="9.5" rx="1.5" fill="var(--logo-blue, var(--teal-400))"/>
      <rect x="16.5" y="16.5" width="9.5" height="9.5" rx="1.5" fill="var(--logo-amber, var(--teal-700))"/>
    </g>
  </svg>
  <span>Kenniswerkplaats</span>
