---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import CaseCard from './CaseCard.astro';
import { aanbodBySlug } from '../data/aanbod';
import { caseById } from '../data/cases';
import { site } from '../data/site';
import type { AiProduct } from '../data/ai-producten';
interface Props { product: AiProduct }
const { product: p } = Astro.props;
const a = aanbodBySlug[p.slug];
const contact = `/contact/?onderwerp=${encodeURIComponent(a.naam)}`;
const voorbeeld = p.voorbeeld ? `mailto:${site.email}?subject=${encodeURIComponent(p.voorbeeld)}` : undefined;
---
<Base title={a.naam} description={p.intro}>
  <div class="product-page">
    <header class="page-head"><div class="wrap">
      <p class="crumbs"><a href="/aanbod/">Aanbod</a> / {a.groep}</p>
      <div class="product-hero">
        <div><p class="eyebrow">{a.groep}</p><h1>{a.naam}</h1><p class="hero-belofte">{p.belofte}</p><p class="lead">{p.intro}</p><p class="hero-uitleg">{p.uitleg}</p>
          <div class="hero-actions"><a class="btn" href={contact}>{p.actie} <Icon name="arrow" size={18} /></a>{voorbeeld ? <a class="textlink" href={voorbeeld}>Vraag een voorbeelduitwerking</a> : <a class="textlink" href="#systeem">Bekijk de opbouw</a>}</div>
        </div>
        <aside class="schema" aria-labelledby="schema-titel"><p class="eyebrow" id="schema-titel">{p.schema.titel}</p><ol>{p.schema.items.map((x,i) => <li><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span><strong>{x}</strong></li>)}</ol><div class="schema-resultaat"><Icon name="target" size={28} /><strong>{p.schema.uitkomst}</strong></div><p class="kleine-noot">{p.schema.noot}</p></aside>
      </div>
    </div></header>

    <section><div class="wrap herkenning"><div><p class="eyebrow">Herkenbaar?</p><h2>{p.herkenning.titel}</h2><p class="herkenning-noot">{p.herkenning.noot}</p></div><ul class="check-list">{p.herkenning.items.map(x => <li>{x}</li>)}</ul></div></section>

    {p.secties.map((s, index) => <section class:list={{ zacht: s.zacht }} id={index === 0 ? 'systeem' : undefined}><div class="wrap">
      {s.label && <p class="eyebrow">{s.label}</p>}<h2>{s.titel}</h2>{s.intro && <p class="section-intro">{s.intro}</p>}
      <div class={`product-grid cols-${s.kolommen ?? 3}`}>{s.kaarten.map(k => <article class="card product-card">{k.marker && <span class="marker" aria-hidden="true">{k.marker}</span>}<h3>{k.titel}</h3>{k.tekst && <p>{k.tekst}</p>}{k.items && <ul class="check-list">{k.items.map(x => <li>{x}</li>)}</ul>}</article>)}</div>
      {s.noot && <p class="section-noot">{s.noot}</p>}
    </div></section>)}

    <section class="zacht"><div class="wrap"><p class="eyebrow">Passend bij je scope</p><h2>{p.varianten.titel}</h2><p class="section-intro">{p.varianten.intro}</p>
      <div class={`product-grid cols-${p.varianten.items.length}`}>{p.varianten.items.map(v => <article class="card variant"><h3>{v.titel}</h3><p class="variant-scope">{v.scope}</p><span class="tijd-label">{v.tijd}</span>{v.tekst && <p>{v.tekst}</p>}{v.items && <ul class="check-list">{v.items.map(x => <li>{x}</li>)}</ul>}{v.grens && <p class="variant-grens">{v.grens}</p>}<a class="textlink" href={`/contact/?onderwerp=${encodeURIComponent(v.contact)}`}>Bespreek deze variant <Icon name="arrow" size={16} /></a></article>)}</div>
      <p class="section-noot">{p.varianten.noot}</p><details class="scope"><summary>Wat buiten de scope valt</summary><p>{p.scope}</p></details>
    </div></section>

    <section class="cases-section"><div class="wrap"><p class="eyebrow">Ervaring met de aanpak</p><h2>Eerder aangepakt</h2><p class="section-intro">{a.casesIntro}</p><div class="cases-grid">{a.cases.map(id => <CaseCard c={caseById[id]} highlight={a.fasen} />)}</div></div></section>

    <section><div class="wrap faq-layout"><div><p class="eyebrow">Praktische vragen</p><h2>Veelgestelde vragen</h2></div><div class="vragen">{p.faq.map(f => <details><summary>{f.vraag}</summary><p>{f.antwoord}</p></details>)}</div></div></section>

    <section class="zacht"><div class="wrap"><h2>De juiste ingang voor je vraagstuk</h2><p class="section-intro">{p.vervolg}</p><div class="product-grid cols-2">{p.verwant.map(slug => <a class="card vervolg" href={`/aanbod/${slug}/`}><h3>{aanbodBySlug[slug].naam}</h3><p>{aanbodBySlug[slug].kort}</p><span class="textlink">Bekijk het aanbod <Icon name="arrow" size={16} /></span></a>)}</div></div></section>

    <section class="tight"><div class="wrap"><div class="product-contact"><div><h2>Eerst samen kijken of het past</h2><p>{p.contact}</p></div><div class="contact-acties"><a class="btn" href={contact}>{p.actie} <Icon name="arrow" size={18} /></a>{voorbeeld && <a class="textlink" href={voorbeeld}>Vraag een voorbeelduitwerking</a>}</div></div></div></section>
  </div>
</Base>
<style>
  .product-page h2 { font-size:clamp(1.55rem,3vw,2rem); line-height:1.2; margin-bottom:24px; }
  .product-page h3 { font-size:1.2rem; line-height:1.3; overflow-wrap:anywhere; }
  #systeem { scroll-margin-top:88px; }
  .product-hero { display:grid; grid-template-columns:minmax(0,1.25fr) minmax(0,.85fr); gap:64px; align-items:center; }
  .product-hero h1 { margin-bottom:8px; }.hero-belofte { font-size:clamp(1.4rem,3vw,2rem); line-height:1.3; font-weight:650; margin:0 0 24px; }.hero-uitleg { color:var(--ink-2); max-width:38rem; }
  .schema { background:white; border:1px solid var(--line-2); border-radius:var(--radius); padding:28px; box-shadow:var(--shadow); }.schema ol { list-style:none; margin:0; padding:0; display:grid; gap:10px; }.schema li { display:flex; align-items:center; gap:14px; padding:14px; border-radius:12px; background:var(--surface); }.schema li span { color:var(--ink-3); font-size:.875rem; }.schema li strong { font-size:1rem; }.schema-resultaat { margin-top:20px; display:flex; align-items:center; gap:14px; padding:20px 16px; background:var(--tech-tint); border-radius:12px; }.schema-resultaat svg { flex-shrink:0; }.kleine-noot { color:var(--ink-3); font-size:.875rem; margin:16px 0 0; }
  .herkenning { display:grid; grid-template-columns:1fr 1fr; gap:64px; }.herkenning-noot { color:var(--ink-2); }.herkenning>.check-list { align-self:center; }
  .zacht { background:var(--surface); }.section-intro { color:var(--ink-2); max-width:48rem; margin-bottom:28px; }
  .product-grid { display:grid; gap:24px; margin-top:28px; }.cols-2 { grid-template-columns:repeat(2,minmax(0,1fr)); }.cols-3 { grid-template-columns:repeat(3,minmax(0,1fr)); }.cols-4 { grid-template-columns:repeat(4,minmax(0,1fr)); }
  .product-card { min-width:0; }.product-card p,.variant p,.vervolg p { color:var(--ink-2); margin:0; }.marker { width:44px; height:44px; display:grid; place-items:center; border-radius:50%; background:var(--surface); color:var(--ink); font-weight:700; margin-bottom:4px; }.section-noot { color:var(--ink-3); font-size:.9375rem; max-width:58rem; margin:24px 0 0; }
  .tijd-label { display:inline-block; align-self:flex-start; background:var(--action-tint); color:var(--ink-2); padding:7px 12px; font-size:.875rem; border-radius:24px; }.variant .variant-scope { font-size:.9375rem; }.variant .variant-grens { border-top:1px solid var(--line-2); padding-top:16px; color:var(--ink-3); font-size:.9375rem; }.variant .textlink { margin-top:auto; }.variant .check-list { margin-bottom:0; }
  .scope { margin-top:28px; background:white; padding:18px 24px; border:1px solid var(--line-2); border-radius:12px; }.scope summary { cursor:pointer; color:var(--action); font-weight:650; }.scope p { color:var(--ink-2); margin-bottom:0; }
  .faq-layout { display:grid; grid-template-columns:1fr 1.6fr; gap:48px; }.vragen details { border-bottom:1px solid var(--line-2); padding:20px 0; }.vragen details:first-child { border-top:1px solid var(--line-2); }.vragen summary { cursor:pointer; color:var(--action); font-weight:650; padding-right:12px; }.vragen p { margin-bottom:0; color:var(--ink-2); }.vervolg { text-decoration:none; }.vervolg .textlink { margin-top:auto; }
  .product-contact { display:grid; grid-template-columns:1.4fr 1fr; gap:40px; align-items:center; background:var(--tech-tint); padding:36px; border-radius:var(--radius); }.product-contact p { color:var(--ink-2); margin-bottom:0; }.contact-acties { display:flex; flex-direction:column; align-items:flex-start; gap:18px; }
  @media(max-width:1000px) { .cols-4 { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:900px) { .product-hero { grid-template-columns:1fr; gap:32px; }.schema { max-width:580px; }.herkenning { gap:32px; }.cols-3 { grid-template-columns:1fr; } }
  @media(max-width:600px) { .herkenning,.cols-2,.cols-4,.faq-layout,.product-contact { grid-template-columns:1fr; }.herkenning,.faq-layout { gap:24px; }.schema { padding:24px 20px; }.product-contact { padding:24px; gap:24px; }.contact-acties .btn { width:100%; }.hero-actions { align-items:flex-start; }.scope { padding:16px; }.vragen summary { min-height:44px; } }
</style>
