---
import type { Case } from '../data/cases';
import type { FaseKey } from '../data/fasen';
import PhaseDots from './PhaseDots.astro';
interface Props { c: Case; highlight?: FaseKey[] }
const { c, highlight = [] } = Astro.props;
---
<article class="case-card" id={`case-${c.id}`}>
  <p class="case-domain">{c.domein}</p>
  <h3><button type="button" class="case-open" data-case-dialog={`dialog-${c.id}`} aria-haspopup="dialog">{c.vraagstuk}</button></h3>
  <p class="case-text case-summary">{c.tekst}</p>
  <p class="case-teaser-org">{c.organisatie}</p>
  <span class="case-read" aria-hidden="true">Bekijk de case <span>↗</span></span>
</article>
<dialog id={`dialog-${c.id}`} class="case-dialog" aria-labelledby={`title-${c.id}`}>
  <div class="dialog-inner">
  <form method="dialog"><button class="case-close" aria-label="Case sluiten">Sluiten <span aria-hidden="true">×</span></button></form>
  <p class="case-domain">{c.domein}</p>
  <h2 id={`title-${c.id}`}>{c.vraagstuk}</h2>
  <p class="case-text">{c.tekst}</p>
  <dl>
    <div><dt>Rol</dt><dd>{c.rol}</dd></div>
    <div><dt>Aanpak</dt><dd>{c.aanpak}</dd></div>
    <div><dt>Opbrengst</dt><dd>{c.opbrengst}</dd></div>
  </dl>
  <PhaseDots values={c.fasen} highlight={highlight} />
  <p class="case-org">{c.organisatie} <span>· {c.periode}</span></p>
  </div>
</dialog>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-case-dialog]').forEach((button) => {
    const dialog = document.getElementById(button.dataset.caseDialog!) as HTMLDialogElement | null;
    if (!dialog) return;
    button.addEventListener('click', () => {
      dialog.showModal();
      document.body.classList.add('case-modal-open');
    });
    dialog.addEventListener('close', () => {
      document.body.classList.remove('case-modal-open');
      button.focus();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target !== dialog) return;
      const rect = dialog.getBoundingClientRect();
      if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
    });
  });
</script>
<style>
  .case-card { position:relative; padding:26px; transition:box-shadow .18s, border-color .18s; }
  .case-card:hover { border-color:var(--teal-400); box-shadow:0 12px 32px #10283a12; }
  .case-open { padding:0; border:0; background:none; color:var(--ink); font:inherit; text-align:left; cursor:pointer; }
  .case-open::after { content:''; position:absolute; inset:0; border-radius:var(--radius); }
  .case-open:focus-visible { outline:none; }
  .case-open:focus-visible::after { outline:3px solid var(--brand-blue-dark); outline-offset:4px; }
  .case-summary { display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
  .case-teaser-org { font-size:.875rem; color:var(--ink-3); margin:0; }
  .case-read { margin-top:auto; padding-top:12px; color:var(--brand-blue-dark); font-weight:650; display:flex; justify-content:space-between; }
  .case-dialog { width:min(720px,calc(100vw - 32px)); max-height:calc(100dvh - 48px); padding:0; border:1px solid var(--line); border-radius:24px; background:white; color:var(--ink); box-shadow:0 24px 80px #101c3030; overflow:auto; }
  .case-dialog::backdrop { background:#101c3066; backdrop-filter:blur(4px); }
  .dialog-inner { padding:32px; container-type:inline-size; }
  form { display:flex; justify-content:flex-end; margin-bottom:20px; }
  .case-close { border:1px solid var(--line); background:var(--teal-50); color:var(--ink); padding:8px 14px; border-radius:24px; font:inherit; cursor:pointer; display:flex; gap:12px; align-items:center; }
  .case-close span { font-size:1.5rem; line-height:1; }
  h2 { font-size:clamp(1.5rem,4vw,2rem); }
  dl { margin:24px 0; display:grid; gap:16px; }
  dt { font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; color:var(--ink-3); font-weight:650; }
  dd { margin:4px 0 0; }
  :global(body.case-modal-open) { overflow:hidden; }
  @media(max-width:480px) { .dialog-inner { padding:24px 20px; } }
</style>
