---
import type { Case } from '../data/cases';
import { fasen } from '../data/fasen';
import { faseStatus } from '../data/caseVisualisaties';
interface Props { c: Case; variant: string }
const { c, variant } = Astro.props;
const icons = ['M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12 M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0', 'm4 16-1 5 5-1L21 7l-4-4L4 16 M14 6l4 4', 'm8 5-7 7 7 7 M16 5l7 7-7 7 M14 3l-4 18', 'M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0 M16 8l-3 5-5 3 3-5 5-3'];
---
<article class="case-card">
  <p class="case-domain">{c.domein}</p>
  <h3>{c.vraagstuk}</h3>
  <p class="case-text">{c.tekst}</p>
  <dl>
    <div><dt>Rol</dt><dd>{c.rol}</dd></div>
    <div><dt>Aanpak</dt><dd>{c.aanpak}</dd></div>
    <div><dt>Opbrengst</dt><dd>{c.opbrengst}</dd></div>
  </dl>
  <ul class:list={['phase-visual', variant]} aria-label="Fasen aangetoond in deze case">
    {fasen.map((f, i) => <li class={`status-${c.fasen[f.key]}`}>
      {variant === 'icons' ? <span class="phase-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d={icons[i]} /></svg></span> : <span class="phase-mark" aria-hidden="true"></span>}
      <span class="phase-name">{f.naam}</span>
      <span class="phase-status">{faseStatus[c.fasen[f.key]]}</span>
    </li>)}
  </ul>
  <p class="case-org">{c.organisatie} <span>· {c.periode}</span></p>
</article>
<style>
  .phase-visual { list-style:none; margin:24px 0 16px; padding:20px 0 0; border-top:1px solid #dbe5e3; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:8px; }
  li { position:relative; display:flex; flex-direction:column; align-items:center; text-align:center; gap:8px; color:#165a53; min-width:0; }
  .phase-name { font-size:.875rem; font-weight:650; line-height:1.35; }
  .phase-status { font-size:.75rem; line-height:1.4; color:#526460; }
  .status-0 { color:#526460; }
  .phase-mark { width:18px; height:18px; flex-shrink:0; border:2px solid #79948f; border-radius:50%; background:white; z-index:1; }
  .status-2 .phase-mark { background:#17675c; border-color:#17675c; }
  .status-1 .phase-mark { background:linear-gradient(90deg,#17675c 50%,white 50%); border-color:#17675c; }
  .stepper li:not(:last-child):after { content:''; position:absolute; top:8px; left:calc(50% + 13px); width:calc(100% - 18px); height:2px; background:#c9d9d6; }
  .pills { display:flex; flex-wrap:wrap; gap:8px; }
  .pills li { flex-direction:row; flex-wrap:wrap; justify-content:center; border-radius:22px; padding:10px 14px; background:#edf1f0; color:#526460; }
  .pills .phase-mark { width:12px; height:12px; }
  .pills .status-2 { background:#17675c; color:white; }
  .pills .status-2 .phase-mark { border-color:white; background:white; }
  .pills .status-2 .phase-status { color:white; }
  .pills .status-1 { background:#e5f1ed; border:1px dashed #17675c; color:#165a53; }
  .segments { gap:3px; }
  .segments li { background:#edf1f0; padding:14px 5px; border-top:5px solid #b6c7c3; }
  .segments .status-2 { border-color:#17675c; background:#e5f1ed; }
  .segments .status-1 { border-image:repeating-linear-gradient(90deg,#17675c 0 6px,#b6c7c3 6px 12px) 1; background:#f0f5f3; }
  .segments .phase-mark { display:none; }
  .phase-icon { width:38px; height:38px; display:grid; place-items:center; border-radius:10px; background:#edf1f0; }
  svg { width:23px; height:23px; }
  .status-2 .phase-icon { background:#17675c; color:white; }
  .status-1 .phase-icon { background:#e5f1ed; border:1px dashed #17675c; }
  @media(max-width:480px) { .phase-visual:not(.pills) { grid-template-columns:repeat(2,minmax(0,1fr)); row-gap:18px; } .stepper li:nth-child(2):after { display:none; } }
</style>
