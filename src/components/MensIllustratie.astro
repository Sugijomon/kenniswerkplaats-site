---
import { illustraties } from '../data/illustraties';
import type { GroepKey } from '../data/aanbod';
interface Props { groep?: GroepKey; compact?: boolean }
const { groep = 'platforms', compact = false } = Astro.props;
const beeld = illustraties[groep];
---
<img class:list={['mens-illustratie', { compact }]} src={beeld.src} alt={beeld.alt} width="1536" height="1024" loading={compact ? 'lazy' : 'eager'} decoding="async" />
<style>.mens-illustratie { display:block; width:100%; height:auto; border-radius:18px; object-fit:contain; }.compact { max-height:180px; object-fit:contain; }</style>
